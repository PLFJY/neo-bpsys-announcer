{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neo-bpsys-announcer",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-07",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "SESSION_KV" }
  ]
}
